@echo off
powershell -NoProfile -ExecutionPolicy Bypass -Command "try { $r = Invoke-WebRequest -UseBasicParsing http://127.0.0.1:8787/; Write-Host ('Controller OK: ' + $r.StatusCode) } catch { Write-Host ('Controller not reachable: ' + $_.Exception.Message); exit 1 }; try { $t = Invoke-RestMethod http://127.0.0.1:8787/api/tunnel; if ($t.publicUrl) { Write-Host ('Public tunnel URL: ' + $t.publicUrl) } else { Write-Host 'Public tunnel not detected.' } } catch { Write-Host ('Tunnel check failed: ' + $_.Exception.Message) }"
