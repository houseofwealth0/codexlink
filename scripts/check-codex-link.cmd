@echo off
powershell -NoProfile -ExecutionPolicy Bypass -Command "try { $r = Invoke-WebRequest -UseBasicParsing http://127.0.0.1:8787/; Write-Host ('Controller OK: ' + $r.StatusCode) } catch { Write-Host ('Controller not reachable: ' + $_.Exception.Message); exit 1 }; try { $t = Invoke-RestMethod http://127.0.0.1:4040/api/tunnels; $u = ($t.tunnels | ? { $_.proto -eq 'https' } | select -First 1).public_url; if ($u) { Write-Host ('ngrok URL: ' + $u) } else { Write-Host 'ngrok running, but no HTTPS URL found' } } catch { Write-Host ('ngrok check failed: ' + $_.Exception.Message) }"
